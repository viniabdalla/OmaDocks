{
  "schemaVersion": 1,
  "id": "io.github.viniabdalla.omadocks",
  "name": "OmaDocks",
  "version": "0.2.0",
  "author": "viniabdalla; based on Dockseid by Silkvain",
  "license": "MIT",
  "description": "Omarchy dock with folder stacks, independent bar favorites, app selection and theme integration.",
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Dock.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaDocks settings",
    "description": "Opens OmaDocks settings",
    "category": "Compositor",
    "allowMultiple": false
  }
}
